{
  "expo": {
    "name": "GymBrô",
    "slug": "gymbro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymbro",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "br.ucb.gymbro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.ucb.gymbro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O GymBrô usa sua localização para encontrar academias perto de você. Sua localização exata nunca é mostrada a outras pessoas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O GymBrô precisa acessar suas fotos para você montar o perfil e publicar seus treinos.",
          "cameraPermission": "O GymBrô usa a câmera para você tirar a foto do treino."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O GymBrô usa a câmera para você tirar a foto do treino."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BE5049"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0B"
  }
}